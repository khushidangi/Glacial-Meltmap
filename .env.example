# ====================================
# Glacial MeltMap Configuration
# ====================================

# ===== BACKEND CONFIGURATION =====

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=True

# Server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database (optional)
DATABASE_URL=sqlite:///glacial_meltmap.db

# Data paths
DATA_DIR=./data
SHAPEFILES_DIR=./data/shapefiles
MODELS_DIR=./models
OUTPUT_DIR=./output

# ===== FRONTEND CONFIGURATION =====

# API endpoint
REACT_APP_API_URL=http://localhost:5000

# Map API keys
REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here

# Environment
REACT_APP_ENVIRONMENT=development
REACT_APP_LOG_LEVEL=debug

# ===== EXTERNAL SERVICES =====

# Google Earth API
GOOGLE_EARTH_API_KEY=your_google_earth_api_key_here

# Analytics (optional)
ANALYTICS_ENABLED=false
ANALYTICS_KEY=your_analytics_key_here

# ===== SECURITY =====

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Session secret
SECRET_KEY=your_secret_key_here_change_in_production

# ===== DEPLOYMENT =====

# AWS (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here

# Docker
DOCKER_ENABLED=false

# ===== FEATURES =====

# Enable/disable features
FEATURE_GOOGLE_EARTH=true
FEATURE_PREDICTIONS=true
FEATURE_STORY_MODE=true
FEATURE_EXPORT=true

# ===== DEFAULTS =====

# Default region
DEFAULT_REGION=himalayas

# Default year
DEFAULT_YEAR=2017

# Number of prediction years
PREDICTION_YEARS=10
